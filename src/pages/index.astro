---
import Base from '../layouts/Base.astro';
import Lottie from '../components/Lottie.astro';
import Button from '../components/Button.astro';
import ProjectTabs from '../components/ProjectTabs.astro';
import { site } from '../site.config';
import { media } from '../lib/media';
---
<Base>
  <Lottie name="background" class="wave" />

  <section class="hero">
    <h1 class="hero__title">
      I'm committed to interpreting <span class="hl hl--orange">complicated human problems</span> into <span class="hl hl--teal">simple digital experiences</span>.
    </h1>
    <div class="hero__intro">
      <p>Hi there, my name is <span class="hl hl--orange">Clem</span>.</p>
      <p>I'm a product designer with a background in <span class="hl hl--teal">quantitative user research</span> and <span class="hl hl--teal">agile project management</span>.</p>
      <p>📍 {site.location}</p>
      <div class="hero__buttons">
        <Button href={media(site.resume)}>Resume</Button>
        <Button href={site.links.linkedin}>LinkedIn</Button>
        <a class="button" href={`mailto:${site.email}`}>Email ↗</a>
      </div>
    </div>
    <a href="#projects" class="hero__scroll" aria-label="Scroll to projects"><Lottie name="scroll-down" /></a>
  </section>

  <section class="projects" id="projects">
    <div class="container">
      <h2 class="eyebrow">Projects</h2>
      <ProjectTabs />
    </div>
  </section>
</Base>

<style>
  :global(.wave) { width: 100%; aspect-ratio: 375 / 70; margin-top: calc(var(--nav-h) * -1 - 60px); opacity: .69; pointer-events: none; position: relative; z-index: 0; }
  .hero { max-width: var(--max); margin: 0 auto; padding: 40px var(--gutter) 20px; font-family: var(--font-display); }
  .hero__title { font-size: clamp(2rem, 4.2vw, 2.75rem); line-height: 1.4; font-weight: 400; margin: 0 0 1.2em; }
  .hero__title .hl { font-weight: 700; }
  .hero__intro p { font-family: var(--font-display); font-weight: 300; margin: 0 0 1.2em; }
  .hero__buttons { margin-top: 1.5em; }
  .hero__scroll { display: block; width: 100px; margin: 40px auto 0; transition: transform .2s; }
  .hero__scroll:hover { transform: scale(1.3); }
  .projects .eyebrow { margin-top: 0; }
  @media (max-width: 767px) { .hero { text-align: center; } .hero__title { font-size: 2rem; } }
</style>
