---
import Base from '../layouts/Base.astro';
import Lottie from '../components/Lottie.astro';
import Button from '../components/Button.astro';
import Img from '../components/Img.astro';
import { site } from '../site.config';
import { media } from '../lib/media';
// Experience & education live in src/data/experience.ts.
import { experience, education } from '../data/experience';
// Flag images (SVG, so they look the same on every computer — emoji flags show as letters on Windows)
import { CN, HK, VN, FR, US } from 'country-flag-icons/string/3x2';
const languages = [
  { name: 'Mandarin', flag: CN, where: 'China' },
  { name: 'Cantonese', flag: HK, where: 'Hong Kong' },
  { name: 'Vietnamese', flag: VN, where: 'Vietnam' },
  { name: 'French', flag: FR, where: 'France' },
  { name: 'English', flag: US, where: 'United States' },
];
---

<Base title="About Clem" description="Clem Mooc: research program manager, former quantitative UX researcher, and an interpreter at heart.">
  <Lottie name="background" class="wave" />

  <!-- Story (dark, under the wave) -->
  <div class="about">
    <div class="about__intro">
      <div class="about__photo"><Img src="about/portfolio-images.png" alt="Portrait of Clem" eager zoom={false} /></div>
      <div class="about__story">
        <h1 class="about__title">An interpreter at heart.</h1>
        <p>I grew up in a household that spoke <span class="langs"><button type="button" class="langs__trigger" aria-describedby="langs-list">five languages</button><span class="langs__list" id="langs-list" role="tooltip">{languages.map((l, i) => <span class="langs__item"><span class="langs__flag" aria-hidden="true" set:html={l.flag} />{l.name}{i < languages.length - 1 && <span class="sr-only">,</span>}</span>)}</span></span>. English was my third, and my parents' weakest. As the kid of Vietnam War refugees, <strong>I was my family's interpreter</strong> long before I knew it was a skill.</p>
        <p>I've kept doing that job in every role since: as a quantitative user researcher at Redfin, a product manager at a fintech startup, and a digital project manager at a cloud software company. Most recently I ran research programs at Meta Reality Labs, where the work was still translation: turning what people do and need into clear decisions that engineers, vendors, and product teams could act on.</p>
        <div class="about__buttons">
          {site.resume && <Button href={media(site.resume)} arrow={false}>Resume</Button>}
          {/* Logo-only links; the hidden text and title keep them readable for screen readers and web scrapers */}
          <a class="button button--ghost button--icon" href={site.links.linkedin} target="_blank" rel="me noopener" title="LinkedIn">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            <span class="sr-only">LinkedIn</span>
          </a>
          <a class="button button--ghost button--icon" href={site.links.github} target="_blank" rel="me noopener" title="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"/></svg>
            <span class="sr-only">GitHub</span>
          </a>
          <button type="button" class="button button--ghost copy-email" data-email={site.email}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span class="copy-email__text">{site.email}</span><span class="sr-only"> (copy email address)</span>
          </button>
        </div>
        <p class="sr-only" role="status" aria-live="polite" id="copy-status"></p>
      </div>
    </div>
  </div>

  <!-- Experience + education -->
  <section class="section--dark cv" aria-label="Experience and education">
    <div class="cv__inner">
      <section aria-labelledby="xp-title">
        <h2 class="cv__h2" id="xp-title">Experience</h2>
        {/* Just company + role; the details live in the résumé. */}
        {experience.map((e) => (
          <div class="entry">
            <h3>
              {e.url ? <a href={e.url} target="_blank" rel="noopener">{e.org}<span class="sr-only"> (opens in a new tab)</span></a> : <span class="entry__org">{e.org}</span>}
              <span class="entry__role">{e.role}</span>
            </h3>
            {e.team && <p class="entry__team">{e.team}</p>}
          </div>
        ))}
      </section>
      <section aria-labelledby="edu-title">
        <h2 class="cv__h2" id="edu-title">Education</h2>
        {education.map((e) => (
          <div class="entry">
            <h3>{e.title}</h3>
            <p class="entry__school">{e.school}</p>
          </div>
        ))}
      </section>
    </div>
  </section>

</Base>

<script>
  // Copy email (E1): the address itself is the button. Click copies it and briefly says "Copied".
  const copyBtn = document.querySelector<HTMLButtonElement>('.copy-email');
  const copyText = copyBtn?.querySelector<HTMLElement>('.copy-email__text');
  const status = document.getElementById('copy-status');
  let reset = 0;
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email!;
    try {
      await navigator.clipboard.writeText(email);
      copyText!.textContent = 'Copied ✓';
      status!.textContent = 'Email address copied';
      clearTimeout(reset);
      reset = window.setTimeout(() => { copyText!.textContent = email; status!.textContent = ''; }, 1800);
    } catch {
      location.href = `mailto:${email}`; // clipboard blocked: open the mail app instead
    }
  });

  // Five languages: dotted underline + tooltip with flags (above the words).
  // Opens on hover, keyboard focus, or tap; stays open while the pointer is on it; Esc closes (WCAG 1.4.13).
  const langs = document.querySelector<HTMLElement>('.langs');
  const trigger = langs?.querySelector<HTMLButtonElement>('.langs__trigger');
  if (langs && trigger) {
    trigger.addEventListener('click', () => langs.classList.toggle('is-open'));
    langs.addEventListener('mouseleave', () => langs.classList.remove('is-dismissed'));
    trigger.addEventListener('blur', () => langs.classList.remove('is-open', 'is-dismissed'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { langs.classList.remove('is-open'); langs.classList.add('is-dismissed'); }
    });
    document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.langs')) langs.classList.remove('is-open'); });
  }
</script>

<style>
  /* Same top spacing as the home intro, so both page titles start at the same height */
  .about { max-width: var(--max); margin: 0 auto; padding: clamp(40px, 7vw, 88px) var(--gutter) 88px; }
  .about__intro { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; align-items: start; }
  .about__photo { align-self: center; }
  .about__photo :global(.img) { margin: 0; }
  .about__title { font-size: clamp(2.2rem, 5vw, 3.5rem); line-height: 1.1; letter-spacing: -.025em; margin: 0 0 1.25rem; }
  .about__story p { font-size: 1.1rem; color: var(--on-ink-muted); max-width: 56ch; }
  .about__story strong { color: var(--on-ink); font-weight: 600; }
  .about__buttons { margin-top: 1.75rem; display: flex; flex-wrap: wrap; }

  .copy-email { text-transform: none; letter-spacing: 0; }
  .copy-email__text { font-weight: 600; }

  /* Five languages: dotted underline + dark tooltip with flags, shown ABOVE the words */
  .langs { position: relative; white-space: nowrap; }
  .langs__trigger {
    font: inherit; color: var(--on-ink); background: none; border: 0; padding: 0; cursor: help;
    text-decoration: underline dotted var(--on-ink-muted); text-decoration-thickness: 2px; text-underline-offset: 5px;
  }
  .langs__trigger:hover { text-decoration-color: var(--on-ink); }
  .langs__list {
    position: absolute; left: -12px; bottom: calc(100% + 10px); z-index: 20;
    display: grid; gap: 6px; padding: 12px 16px; min-width: 180px;
    background: var(--ink-2); color: var(--on-ink); border: 1px solid var(--line-dark); border-radius: 12px;
    box-shadow: 0 12px 32px #0008; font: 500 15px/1.3 var(--font-body); white-space: nowrap;
    opacity: 0; visibility: hidden; transform: translateY(4px); transition: opacity .18s, transform .18s, visibility .18s;
  }
  /* small bridge so the pointer can move from the words onto the tooltip without it closing */
  .langs__list::before { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 12px; }
  .langs:hover .langs__list, .langs:focus-within .langs__list, .langs.is-open .langs__list { opacity: 1; visibility: visible; transform: none; }
  .langs.is-dismissed .langs__list { opacity: 0; visibility: hidden; }
  .langs__item { display: flex; align-items: center; gap: 10px; }
  .langs__flag { display: inline-flex; width: 22px; flex-shrink: 0; border-radius: 3px; overflow: hidden; box-shadow: 0 0 0 1px #ffffff26; }
  .langs__flag :global(svg) { width: 100%; height: auto; display: block; }

  .cv { background: var(--ink); color: var(--on-ink); }
  .cv__inner { max-width: var(--max); margin: 0 auto; padding: 24px var(--gutter) 88px; display: grid; grid-template-columns: 7fr 5fr; gap: 56px; }
  .cv__h2 { font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin: 0 0 20px; }
  .entry { margin-bottom: 18px; }
  .entry h3 { font-size: 1.1rem; margin: 0; display: flex; flex-wrap: wrap; gap: 0 .6em; align-items: baseline; }
  .entry h3 a, .entry__org { color: var(--accent); text-decoration: none; }
  .entry h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .entry__role { font-family: var(--font-body); font-weight: 400; font-size: 1rem; color: var(--on-ink); }
  .entry__school, .entry__team { color: var(--on-ink-muted); font-size: 16px; margin: .3em 0 0; }


  @media (max-width: 767px) {
    .about { padding-bottom: 56px; }
    .about__intro, .cv__inner { grid-template-columns: 1fr; gap: 32px; }
    .about__photo { max-width: 320px; order: 2; } /* title first on phones, like the home page */
    .cv__inner { padding-block: 48px; }
  }
  .button--icon { width: 48px; height: 48px; padding: 0; justify-content: center; }
</style>
