---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import NextProject from '../../components/NextProject.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { mdxComponents } from '../../components/mdx';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft || import.meta.env.DEV);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
// Reading time: words in the case study (tags and code stripped), at about 220 words a minute
const words = (entry.body ?? '').replace(/<[^>]*>|\{[^}]*\}|[#*_`>|-]/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
---
<Base title={d.seoTitle ?? d.title} description={d.description} image={d.hero ?? d.cover}>
  {d.hero && (
    <div class:list={['hero-banner', { 'hero-banner--backdrop': d.heroBg }]}
      style={`view-transition-name: project-${entry.id};${d.heroBg ? ` --hero-bg: ${d.heroBg};` : ''}`}>
      <Img src={d.hero} alt={d.title} eager zoom={false} class="hero-banner__img" />
    </div>
  )}
  <article class="prose case" style={`--read-time: ' · ${minutes} min read'`}>
    <Content components={mdxComponents} />
  </article>
  <ReadingProgress />
  <OnThisPage />
  <NextProject current={entry.id} />
</Base>

<style>
  .hero-banner { margin-top: calc(var(--nav-h) * -1); }
  /* Transparent banner images get a backdrop color that starts just below the see-through nav,
     so the nav links stay readable over the dark band */
  .hero-banner--backdrop { padding-top: var(--nav-h); background: linear-gradient(var(--ink) var(--nav-h), var(--hero-bg) var(--nav-h)); }
  .hero-banner :global(.img) { margin: 0; }
  /* Full-bleed banner under the see-through nav, shown whole (never cropped) */
  .hero-banner :global(img) { border-radius: 0; width: 100%; height: auto; }
</style>
