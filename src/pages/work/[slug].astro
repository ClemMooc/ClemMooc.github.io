---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import NextProject from '../../components/NextProject.astro';
import { mdxComponents } from '../../components/mdx';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.seoTitle ?? d.title} description={d.description} image={d.hero ?? d.cover}>
  {d.hero && (
    <div class="hero-banner">
      <Img src={d.hero} alt={d.title} eager zoom={false} class="hero-banner__img" />
    </div>
  )}
  <article class="prose case">
    <Content components={mdxComponents} />
  </article>
  <NextProject current={entry.id} />
</Base>

<style>
  .hero-banner { margin-top: calc(var(--nav-h) * -1); }
  .hero-banner :global(.img) { margin: 0; }
  /* Full-bleed banner under the see-through nav, never taller than 520px */
  .hero-banner :global(img) { border-radius: 0; width: 100%; max-height: 520px; object-fit: cover; }
</style>
