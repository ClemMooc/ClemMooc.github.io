---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="container nf">
    <p class="eyebrow">404</p>
    <h1>That page wandered off.</h1>
    <p><a class="button" href="/">Back home</a> <a class="button" href="/#projects">See projects</a></p>
  </div>
</Base>
<style>.nf { min-height: 50vh; } .nf h1 { font-size: clamp(2rem, 5vw, 3.5rem); }</style>
