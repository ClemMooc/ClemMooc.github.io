---
// Click-to-expand panel (no JavaScript needed).
interface Props { title: string; open?: boolean }
const { title, open = false } = Astro.props;
---
<details class="accordion" open={open}>
  <summary><span class="accordion__icon" aria-hidden="true">▾</span>{title}</summary>
  <div class="accordion__body"><slot /></div>
</details>
