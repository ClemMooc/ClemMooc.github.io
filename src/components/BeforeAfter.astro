---
// Before/after comparison slider. NOT IN USE right now (Clem shelved it Oct 2026; kept for later).
// Registered in mdx.ts, so it can be dropped into any case study. Drag the handle, or focus it and use
// the arrow keys, to wipe between the two images. Both images must be the same size.
// <BeforeAfter before="key.png" after="key-b.png" beforeAlt="..." afterAlt="..." caption="..." />
import { Image } from 'astro:assets';
import { media } from '../lib/media';
interface Props { before: string; after: string; beforeAlt: string; afterAlt: string; caption?: string }
const { before, after, beforeAlt, afterAlt, caption } = Astro.props;
---
<figure class="ba" style="--pos: 50%">
  <div class="ba__frame">
    <Image class="ba__img" src={media(after)} alt={afterAlt} inferSize widths={[560, 1112]} sizes="(max-width: 767px) 92vw, 560px" loading="lazy" />
    <div class="ba__before">
      <Image class="ba__img" src={media(before)} alt={beforeAlt} inferSize widths={[560, 1112]} sizes="(max-width: 767px) 92vw, 560px" loading="lazy" />
    </div>
    <span class="ba__tag ba__tag--before" aria-hidden="true">Before</span>
    <span class="ba__tag ba__tag--after" aria-hidden="true">After</span>
    <span class="ba__handle" aria-hidden="true"></span>
    <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Compare before and after: drag left for after, right for before" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((ba) => {
    const range = ba.querySelector<HTMLInputElement>('.ba__range')!;
    const set = () => ba.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>

<style>
  .ba { margin: 2rem auto; max-width: 560px; }
  .ba__frame { position: relative; border-radius: 8px; overflow: hidden; user-select: none; }
  .ba :global(.ba__img) { display: block; width: 100%; height: auto; }
  .ba__before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__handle {
    position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; margin-left: -1.5px;
    background: var(--accent-deep); pointer-events: none;
  }
  .ba__handle::after {
    content: '⟷'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center;
    background: var(--accent-deep); color: #fff; font-size: 18px; box-shadow: 0 2px 8px #0004;
  }
  .ba__tag {
    position: absolute; top: 10px; padding: 4px 10px; border-radius: 999px; pointer-events: none;
    font: 600 12px/1.4 var(--font-display); letter-spacing: .08em; text-transform: uppercase;
    background: rgb(20 18 17 / .8); color: var(--on-ink);
  }
  .ba__tag--before { left: 10px; }
  .ba__tag--after { right: 10px; }
  /* The range input covers the whole image: drag anywhere. Invisible, but keyboard-focusable. */
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .ba__frame:has(.ba__range:focus-visible) { outline: 3px solid var(--accent-deep); outline-offset: 3px; }
  .ba figcaption { font: 400 15px/1.6 var(--font-body); color: var(--text-muted); text-align: center; margin-top: .6rem; }
</style>
