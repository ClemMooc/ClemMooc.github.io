---
// "On this page" table of contents for case studies (desktop only, wide screens).
// Built from the section labels (<Eyebrow>Problem</Eyebrow> etc.), so it updates itself
// when a case study changes. Highlights the section you're reading.
---
<nav class="toc" aria-label="On this page" hidden>
  <p class="toc__title">On this page</p>
  <ol class="toc__list"></ol>
</nav>

<script>
  const toc = document.querySelector<HTMLElement>('.toc')!;
  const list = toc.querySelector('ol')!;
  const labels = [...document.querySelectorAll<HTMLElement>('.prose .eyebrow')]
    .filter((e) => !e.classList.contains('eyebrow--statement') && e.nextElementSibling?.tagName !== 'H1');

  if (labels.length >= 2) {
    const links = labels.map((label, i) => {
      const heading = label.nextElementSibling?.tagName === 'H2' ? label.nextElementSibling as HTMLElement : label;
      const target = label;
      target.id ||= `section-${i + 1}-${label.textContent!.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${target.id}`;
      a.textContent = label.textContent!.trim();
      if (heading !== label) a.title = heading.textContent!.trim();
      li.append(a);
      list.append(li);
      return { a, label };
    });
    toc.hidden = false;

    // Highlight the section currently in view
    const setActive = (n: number) => links.forEach((l, i) => {
      l.a.classList.toggle('is-active', i === n);
      if (i === n) l.a.setAttribute('aria-current', 'location'); else l.a.removeAttribute('aria-current');
    });
    const update = () => {
      const line = innerHeight * 0.35;
      let current = 0;
      links.forEach((l, i) => { if (l.label.getBoundingClientRect().top < line) current = i; });
      setActive(current);
      // Only show once the reader is past the intro
      toc.classList.toggle('is-visible', links[0].label.getBoundingClientRect().top < innerHeight * 0.9);
    };
    update();
    addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .toc {
    position: fixed; left: 24px; top: 50%; transform: translateY(-50%); z-index: 30;
    width: 160px; padding: 14px 14px 10px; border-radius: 12px;
    background: rgb(20 18 17 / .88); border: 1px solid var(--line-dark);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    opacity: 0; visibility: hidden; transition: opacity .3s, visibility .3s;
  }
  .toc.is-visible { opacity: 1; visibility: visible; }
  .toc__title { font: 600 .7rem/1.4 var(--font-display); letter-spacing: .12em; text-transform: uppercase; color: var(--on-ink-muted); margin: 0 0 8px; }
  .toc__list { list-style: none; margin: 0; padding: 0; }
  /* (links are created by the script, so they need :global to pick up these styles) */
  .toc__list :global(a) {
    display: block; padding: 6px 0 6px 12px; border-left: 2px solid var(--line-dark);
    font: 500 14px/1.3 var(--font-body); color: var(--on-ink-muted); text-decoration: none;
    transition: color .2s, border-color .2s;
  }
  .toc__list :global(a:hover) { color: var(--on-ink); }
  .toc__list :global(a.is-active) { color: var(--on-ink); border-left-color: var(--accent); }
  .toc__list :global(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  /* Only on screens wide enough to sit beside the content without covering it */
  @media (max-width: 1399px) { .toc { display: none; } }
</style>
