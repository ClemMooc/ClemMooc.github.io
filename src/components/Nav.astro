---
// Top navigation: logo + two links. See-through over the wave at the top of the page,
// solid once you scroll (so page text never shows through behind the links).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { href: '/#projects', label: 'Projects', current: path === '/' || path.startsWith('/work') },
  { href: '/about', label: 'About Clem', current: path === '/about', page: true },
];
---
<header class="nav">
  <a class="nav__logo" href="/" aria-label="Clem Mooc, home">
    <img src="/brand/logo.png" alt="" width="104" height="70" />
    <img class="nav__logo-hover" src="/brand/logo-hover.png" alt="" width="104" height="70" />
  </a>
  <nav class="nav__menu" aria-label="Main">
    {items.map((i) => (
      <a href={i.href} class:list={['nav__link', { 'is-current': i.current }]}
        aria-current={i.current && i.page ? 'page' : undefined}>{i.label}</a>
    ))}
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.nav')!;
  // Hovering (or focusing) the logo replays the wave behind the nav
  const logo = nav.querySelector('.nav__logo')!;
  ['mouseenter', 'focus'].forEach((ev) => logo.addEventListener(ev, () => document.dispatchEvent(new Event('wave:replay'))));
  const onScroll = () => nav.classList.toggle('nav--scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    /* Same side spacing as the page content column, so the logo and links line up with the content edges */
    height: var(--nav-h); padding: 0 calc(max(0px, (100% - var(--max)) / 2) + var(--gutter));
    /* See-through at the top so the wave reads as part of the nav; a soft dark fade keeps links legible */
    background: linear-gradient(rgb(20 18 17 / .85), rgb(20 18 17 / .35) 70%, rgb(20 18 17 / 0));
    transition: transform .4s ease-in-out, background-color .3s, box-shadow .3s;
  }
  /* (hairline drawn with a shadow, not a border, so no stray line shows over the wave) */
  .nav.nav--scrolled { background: var(--ink); box-shadow: 0 1px 0 var(--line-dark); }
  .nav__logo { position: relative; display: block; width: 80px; flex-shrink: 0; }
  .nav__logo img { width: 80px; height: auto; transition: opacity .2s; }
  .nav__logo-hover { position: absolute; inset: 0; opacity: 0; }
  .nav__logo:hover .nav__logo-hover { opacity: 1; }
  .nav__logo:hover img:first-child { opacity: 0; }
  .nav__menu { display: flex; gap: 4px; }
  .nav__link {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-display); font-size: 15px; font-weight: 600;
    text-decoration: none; color: var(--on-ink); padding: 0 16px; border-radius: 999px;
    transition: color .2s;
  }
  .nav__link:hover, .nav__link.is-current { color: var(--accent); }
  @media (max-width: 420px) { .nav__link { padding: 0 10px; } }
</style>
