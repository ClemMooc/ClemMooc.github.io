---
// Switchable panels: each direct child <div> is one panel, in the same order as `labels`.
// <Tabs labels={["Audio alert", "Video alert"]}>
//   <div>…panel 1…</div>
//   <div>…panel 2…</div>
// </Tabs>
interface Props { labels: string[] }
const { labels } = Astro.props;
---
<div class="tabset" data-tabset>
  <div class="tabset__menu" role="tablist">
    {labels.map((l, i) => (
      <button type="button" class="tabset__tab" aria-selected={i === 0 ? 'true' : 'false'}>{l}</button>
    ))}
  </div>
  <div class="tabset__panes"><slot /></div>
</div>

<script>
  import { initTabs } from '../lib/tabs';
  document.querySelectorAll<HTMLElement>('[data-tabset]').forEach((set, n) => {
    initTabs(
      [...set.querySelectorAll<HTMLElement>('.tabset__tab')],
      [...set.querySelector('.tabset__panes')!.children] as HTMLElement[],
      `tabset-${n}`,
    );
  });
</script>

<style>
  .tabset { margin: 1rem 0; }
  .tabset__menu { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .tabset__tab {
    cursor: pointer; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px;
    background: transparent; color: inherit; font: 600 14px/1.4 var(--font-display);
    transition: background-color .2s, color .2s, border-color .2s;
  }
  :global(.section--light) .tabset__tab { border-color: #00000026; }
  .tabset__tab:hover { border-color: var(--orange); }
  .tabset__tab[aria-selected='true'] { background: var(--cream); color: var(--bg); border-color: var(--cream); }
  :global(.section--light) .tabset__tab[aria-selected='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .tabset__tab:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
</style>
