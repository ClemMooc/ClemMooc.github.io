---
// Switchable panels: each direct child <div> is one panel, in the same order as `labels`.
// <Tabs labels={["Audio alert", "Video alert"]}>
//   <div>…panel 1…</div>
//   <div>…panel 2…</div>
// </Tabs>
interface Props { labels: string[] }
const { labels } = Astro.props;
---
<div class="tabset" data-tabset>
  <div class="tabset__menu" role="tablist">
    {labels.map((l, i) => (
      <button type="button" class="tabset__tab" aria-selected={i === 0 ? 'true' : 'false'}>{l}</button>
    ))}
  </div>
  <div class="tabset__panes"><slot /></div>
</div>

<script>
  import { initTabs } from '../lib/tabs';
  document.querySelectorAll<HTMLElement>('[data-tabset]').forEach((set, n) => {
    initTabs(
      [...set.querySelectorAll<HTMLElement>('.tabset__tab')],
      [...set.querySelector('.tabset__panes')!.children] as HTMLElement[],
      `tabset-${n}`,
    );
  });
</script>

<style>
  /* Underline tabs (design brief): muted labels, active one underlined in orange */
  .tabset { margin: 1rem 0; }
  .tabset__menu { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-bottom: 16px; border-bottom: 1px solid var(--line-dark); }
  :global(.section--light) .tabset__menu { border-bottom-color: var(--line-light); }
  .tabset__tab {
    cursor: pointer; background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px;
    padding: 10px 2px; color: var(--on-ink-muted); font: 500 15px/1.4 var(--font-body);
    transition: color .2s, border-color .2s;
  }
  :global(.section--light) .tabset__tab { color: var(--text-muted); }
  .tabset__tab:hover { color: var(--on-ink); }
  :global(.section--light) .tabset__tab:hover { color: var(--text); }
  .tabset__tab[aria-selected='true'] { color: var(--on-ink); border-bottom-color: var(--accent); }
  :global(.section--light) .tabset__tab[aria-selected='true'] { color: var(--text); border-bottom-color: var(--accent-deep); }
  .tabset__tab:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  /* No layout shift when switching tabs: every panel sits in the same grid cell, so the
     tab set is always as tall as its tallest panel. Hidden panels are invisible (and
     skipped by screen readers and the keyboard) but still hold their space. */
  .tabset__panes { display: grid; }
  .tabset__panes > :global(*) { grid-area: 1 / 1; }
  .tabset__panes > :global([hidden]) { display: block; visibility: hidden; }
</style>
