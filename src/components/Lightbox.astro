---
// Click any case-study image (<Img>) to see it full-screen.
// Close with the × button, a click anywhere, or the Esc key.
// Turn it off for one image with <Img ... zoom={false} />.
---

<dialog class="lightbox" aria-label="Enlarged image">
  <button class="lightbox__close" type="button" aria-label="Close">×</button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const big = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;

  function open(fig: HTMLElement) {
    const img = fig.querySelector('img')!;
    // Show the sharp version the browser already loaded, then swap in the full-size original.
    big.src = img.currentSrc || img.src;
    big.alt = img.alt;
    const full = fig.dataset.full;
    if (full && full !== big.src) {
      const hi = new Image();
      hi.onload = () => { if (dialog.open) big.src = full; };
      hi.src = full;
    }
    caption.textContent = fig.querySelector('figcaption')?.textContent ?? '';
    caption.hidden = !caption.textContent;
    dialog.showModal();
    document.documentElement.classList.add('lightbox-open');
  }

  function close() {
    dialog.classList.add('is-closing');
    setTimeout(() => { dialog.classList.remove('is-closing'); dialog.close(); }, 200);
  }

  dialog.addEventListener('click', close);
  dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  dialog.addEventListener('close', () => document.documentElement.classList.remove('lightbox-open'));

  document.querySelectorAll<HTMLElement>('.img--zoom').forEach((fig) => {
    if (fig.closest('a')) return; // images that are links keep working as links
    fig.tabIndex = 0;
    fig.setAttribute('role', 'button');
    fig.setAttribute('aria-label', 'Enlarge image');
    fig.addEventListener('click', () => open(fig));
    fig.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(fig); }
    });
  });
</script>

<style is:global>
  /* Hover: gentle zoom on the image */
  .img--zoom { cursor: zoom-in; }
  .img--zoom img { transition: transform .35s ease, box-shadow .35s ease; }
  .img--zoom:hover img,
  .img--zoom:focus-visible img { transform: scale(1.03); box-shadow: 0 12px 32px rgba(0, 0, 0, .35); }
  .img--zoom:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  .lightbox-open { overflow: hidden; }

  /* Full-screen view */
  .lightbox {
    border: 0; padding: 0; margin: 0; background: transparent;
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    display: none; align-items: center; justify-content: center;
    cursor: zoom-out;
  }
  .lightbox[open] { display: flex; animation: lightbox-in .25s ease both; }
  .lightbox::backdrop { background: rgba(3, 3, 3, .92); animation: lightbox-fade .25s ease both; }
  .lightbox.is-closing { animation: lightbox-out .2s ease both; }
  .lightbox.is-closing::backdrop { animation: lightbox-fade .2s ease reverse both; }
  .lightbox figure { margin: 0; padding: 56px 16px 16px; text-align: center; }
  .lightbox img {
    max-width: min(92vw, 1600px); max-height: calc(100dvh - 140px);
    width: auto; height: auto; border-radius: 4px; display: block; margin: 0 auto;
  }
  .lightbox figcaption {
    color: var(--cream); font-family: var(--font-body); font-size: 14px; font-style: italic;
    margin-top: .75rem;
  }
  .lightbox__close {
    position: fixed; top: 12px; right: 16px; z-index: 1;
    width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: rgba(255, 255, 255, .12); color: #fff; font-size: 28px; line-height: 1; cursor: pointer;
  }
  .lightbox__close:hover { background: rgba(255, 255, 255, .25); }

  @keyframes lightbox-in { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: none; } }
  @keyframes lightbox-out { from { opacity: 1; transform: none; } to { opacity: 0; transform: scale(.95); } }
  @keyframes lightbox-fade { from { opacity: 0; } to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .img--zoom img, .lightbox, .lightbox::backdrop { transition: none; animation: none !important; }
    .img--zoom:hover img { transform: none; }
  }
</style>
