---
// Project card. size="large" for featured work, "small" for the "Other work" row.
// Shows the cover image, title, and (if set in the case study) role and result.
import { Image } from 'astro:assets';
import { media } from '../lib/media';
interface Props {
  href: string; cover: string; title: string;
  role?: string; result?: string; size?: 'large' | 'small'; external?: boolean;
}
const { href, cover, title, role, result, size = 'large', external = false } = Astro.props;
const name = title.replace(' / ', ' ').replace(/:\s*$/, '');
---
<a class:list={['card', `card--${size}`]} href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <div class="card__media">
    <Image src={media(cover)} alt="" inferSize widths={size === 'large' ? [480, 800, 1200] : [400, 640]}
      sizes={size === 'large' ? '(max-width: 767px) 92vw, 46vw' : '(max-width: 767px) 92vw, 30vw'} class="card__img" />
  </div>
  <div class="card__body">
    <h3 class="card__title">{name}{external && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></>}</h3>
    {role && <p class="card__role">{role}</p>}
    {result && size === 'large' && <p class="card__result">{result}</p>}
    {size === 'large' && <span class="card__cta" aria-hidden="true">Read case study →</span>}
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column; height: 100%;
    text-decoration: none; color: var(--cream);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden;
    transition: transform .25s ease, border-color .25s ease;
  }
  .card:hover { transform: translateY(-4px); border-color: #f4efe84d; }
  .card__media { overflow: hidden; background: #000; }
  .card__img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .4s ease; }
  .card:hover .card__img { transform: scale(1.03); }
  .card__body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .card__title { font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; line-height: 1.3; margin: 0; }
  .card__role { font-size: 15px; color: var(--muted); margin: 0; }
  .card__result { font-size: 16px; line-height: 1.6; margin: 4px 0 0; padding-left: 12px; border-left: 2px solid var(--orange); }
  .card__cta { margin-top: auto; padding-top: 12px; font-family: var(--font-display); font-weight: 600; font-size: 15px; color: var(--orange); }
  .card--small .card__body { padding: 16px 18px 20px; }
  .card--small .card__title { font-size: 1.1rem; }
  .card--small .card__role { font-size: 14px; }
</style>
