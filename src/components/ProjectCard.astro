---
// Project card. size="large" for featured work, "small" for the compact "Other projects" list.
// Shows the cover image, title and (if set in the case study) role.
// Light cards on linen by default; adapts when placed in a dark section.
import { Image } from 'astro:assets';
import { media } from '../lib/media';
interface Props {
  href: string; cover: string; title: string;
  role?: string; size?: 'large' | 'small'; external?: boolean;
}
const { href, cover, title, role, size = 'large', external = false } = Astro.props;
const name = title.replace(' / ', ' ').replace(/:\s*$/, '');
// Shared with the case-study banner so the image grows into it on click (see global.css)
const vt = href.match(/^\/work\/([^/]+)/)?.[1];
---
<a class:list={['card', `card--${size}`]} href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <div class="card__media">
    <Image style={vt ? `view-transition-name: project-${vt}` : undefined} src={media(cover)} alt="" inferSize widths={size === 'large' ? [480, 800, 1200] : [192, 288]}
      sizes={size === 'large' ? '(max-width: 767px) 92vw, 46vw' : '96px'} class="card__img" />
  </div>
  <div class="card__body">
    <h3 class="card__title">{name}{external && <><span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></>}</h3>
    {role && <p class="card__role">{role}</p>}
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column; height: 100%;
    text-decoration: none; color: var(--text);
    background: var(--paper-card); border: 1px solid var(--line-light); border-radius: 16px;
    overflow: hidden;
    transition: transform .2s ease, border-color .2s ease;
  }
  .card:hover { transform: translateY(-2px); border-color: var(--accent-deep); }
  .card:focus-visible { outline: 3px solid var(--accent-deep); outline-offset: 3px; }
  :global(.section--dark) .card { background: var(--ink-2); color: var(--on-ink); border-color: var(--line-dark); }
  :global(.section--dark) .card:hover { border-color: var(--accent); }

  .card__media { padding: 12px 12px 0; }
  .card__img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 12px; }
  .card__body { padding: 16px 20px 22px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .card__title { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.3; margin: 0; }
  .card__role { font-size: 15px; line-height: 1.5; color: var(--text-muted); margin: 0; }
  :global(.section--dark) .card__role { color: var(--on-ink-muted); }

  /* Compact row: 96px square thumbnail, title and role side by side */
  .card--small { flex-direction: row; align-items: center; border-radius: 14px; }
  .card--small .card__media { padding: 10px; flex-shrink: 0; }
  .card--small .card__img { width: 96px; height: 96px; aspect-ratio: 1; border-radius: 10px; }
  .card--small .card__body { padding: 10px 18px 10px 4px; justify-content: center; }
  .card--small .card__title { font-size: 1.05rem; }
  .card--small .card__role { font-size: 14px; }
</style>
