---
import { Image } from 'astro:assets';
import { media } from '../lib/media';
interface Props { href: string; cover: string; title: string; external?: boolean }
const { href, cover, title, external = false } = Astro.props;
const lines = title.split(' / ');
---
<a class="card" href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <div class="card__frame">
    <Image src={media(cover)} alt="" inferSize widths={[480, 800, 1200]} sizes="(max-width: 767px) 92vw, 46vw" class="card__img" />
    <h3 class="card__title">{lines.map((l, i) => <>{l}{i < lines.length - 1 && <br />}</>)}{external && ' ↗'}</h3>
  </div>
</a>

<style>
  .card { display: block; text-decoration: none; color: var(--cream); }
  .card__frame {
    border: 4px solid var(--card-border); background: var(--navy);
    border-radius: 20px; padding: 10px; height: 100%;
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .card:hover .card__frame { border-color: var(--blue); transform: scale(1.05); box-shadow: 1px 4px 8px #0006; }
  .card:active .card__frame { border-color: var(--orange); }
  .card__img { transition: transform .2s; }
  .card__img:hover { transform: rotate(4deg); }
  .card__img { width: 100%; height: auto; aspect-ratio: 493 / 330; object-fit: cover; border-radius: 16px; }
  .card__title { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.1rem, 2vw, 1.5rem); line-height: 1.5; margin: 12px 4px 4px; }
</style>
