---
// Embedded video: <Video vimeo="828393638" /> or <Video youtube="dQw4w9WgXcQ" />
interface Props { vimeo?: string; youtube?: string; title?: string }
const { vimeo, youtube, title = 'Video' } = Astro.props;
const src = vimeo
  ? `https://player.vimeo.com/video/${vimeo}?dnt=1`
  : `https://www.youtube-nocookie.com/embed/${youtube}`;
---
<div class="video">
  <iframe src={src} title={title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
</div>
