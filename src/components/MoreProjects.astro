---
// Bottom of each case study: the other projects (skips the one you're on).
import ProjectList from './ProjectList.astro';
interface Props { current: string }
const { current } = Astro.props;
---
<section class="more section--dark" aria-labelledby="more-title">
  <div class="more__inner">
    <h2 class="more__title" id="more-title">More work</h2>
    <ProjectList exclude={current} headingLevel={3} />
  </div>
</section>
<style>
  .more { border-top: 1px solid var(--line); padding: 64px 0 80px; }
  .more__inner { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
  .more__title { font-size: clamp(1.6rem, 3vw, 2.25rem); margin: 0 0 32px; }
</style>
