---
import Section from './Section.astro';
import ProjectTabs from './ProjectTabs.astro';
---
<Section tone="dark">
  <h3 class="more__title">Thanks for checking that out.<br />View more of my projects below:</h3>
  <ProjectTabs id="more" />
</Section>
<style>
  .more__title { text-align: center; font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2.44rem); margin: 1em 0 1.2em; color: var(--cream); }
</style>
