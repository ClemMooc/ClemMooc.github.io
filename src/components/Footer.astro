---
import { site } from '../site.config';
import BackToTop from './BackToTop.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href="/" aria-label="Clem Mooc, home"><img src="/brand/logo.png" alt="" width="104" height="70" /></a>
      <p class="footer__place"><span aria-hidden="true">📍 </span>{site.location}</p>
    </div>
    <p class="footer__copy">© {year} {site.name}</p>
    <nav class="footer__links" aria-label="Footer">
      <div class="footer__row">
        <a href="/#projects">Projects</a>
        <a href="/about">About Clem</a>
      </div>
    </nav>
  </div>
  <BackToTop />
</footer>

<style>
  .footer { background: var(--ink); color: var(--on-ink-muted); border-top: 1px solid var(--line-dark); padding: 0 calc(max(0px, (100% - var(--max)) / 2) + var(--gutter)); font-family: var(--font-display); } /* lines up with the content column */
  .footer__inner {
    padding: 32px 0;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px 28px;
  }
  .footer__brand { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .footer__logo img { width: 64px; height: auto; }
  .footer__place, .footer__copy { margin: 0; font-size: 14px; }
  .footer__links { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; justify-self: end; }
  .footer__row { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .footer__links a { display: inline-block; padding: 6px 0; font-size: 15px; font-weight: 600; color: var(--on-ink); text-decoration: none; }
  .footer__links a:hover { color: var(--accent); }
  @media (max-width: 767px) {
    .footer__inner { grid-template-columns: 1fr; justify-items: start; }
    .footer__links { justify-self: start; align-items: flex-start; order: 2; }
    .footer__copy { order: 3; }
  }
</style>
