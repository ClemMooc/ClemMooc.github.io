---
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import { media } from '../lib/media';
import BackToTop from './BackToTop.astro';
const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="/" aria-label="Clem Mooc, home"><img src="/brand/logo.png" alt="" width="104" height="70" /></a>
      <p>📍 {site.location}</p>
    </div>
    <ul>
      <li><a href="/about">About</a></li>
      <li><a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
      <li><a href={`mailto:${site.email}`}>Email<span aria-hidden="true"> ↗</span></a></li>
      <li><a href={media(site.resume)} target="_blank" rel="noopener">Resume<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
    </ul>
    <ul>
      {work.map((w) => <li><a href={`/work/${w.id}/`}>{w.data.cardTitle.split(' / ')[0].replace(/:$/, '')}</a></li>)}
    </ul>
    <ul>
      <li><a href={site.links.fivehundredpx} target="_blank" rel="noopener">500px<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
      <li><a href={site.links.flickr} target="_blank" rel="noopener">Flickr<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a></li>
    </ul>
  </div>
  <BackToTop />
  <p class="footer__copy">© {year} {site.name}. All rights reserved.</p>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); background: var(--bg); font-family: var(--font-display); padding: 0 var(--gutter); }
  .footer__inner { max-width: var(--max); margin: 0 auto; padding: 48px 0 24px; display: grid; grid-template-columns: 1.2fr 1fr 1.6fr 1fr; gap: 32px; }
  .footer__brand img { width: 104px; height: auto; }
  .footer__brand p { font-size: 14px; margin: 8px 0 0; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 10px; line-height: 1.3; }
  ul a { display: inline-block; padding: 4px 0; font-size: 15px; font-weight: 500; text-decoration: none; color: var(--muted); }
  ul a:hover { color: var(--cream); text-decoration: underline; text-underline-offset: 4px; }
  .footer__copy { text-align: center; font-size: 14px; color: var(--muted); padding: 32px 0 40px; margin: 0; }
  @media (max-width: 767px) { .footer__inner { grid-template-columns: 1fr 1fr; } }
</style>
