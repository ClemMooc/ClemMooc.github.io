---
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import { media } from '../lib/media';
const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="/"><img src="/brand/logo.png" alt="Clem Mooc" width="104" height="70" /></a>
      <p>📍 {site.location}</p>
    </div>
    <ul>
      <li><a href="/about">About</a></li>
      <li><a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
      <li><a href={`mailto:${site.email}`}>Email ↗</a></li>
      <li><a href={media(site.resume)} target="_blank" rel="noopener">Resume ↗</a></li>
    </ul>
    <ul>
      {work.map((w) => <li><a href={`/work/${w.id}/`}>{w.data.cardTitle.split(' / ')[0].replace(/:$/, '')}</a></li>)}
    </ul>
    <ul>
      <li><a href={site.links.fivehundredpx} target="_blank" rel="noopener">500px ↗</a></li>
      <li><a href={site.links.flickr} target="_blank" rel="noopener">Flickr ↗</a></li>
    </ul>
  </div>
  <p class="footer__copy">© {year} {site.name}. All right reserved.</p>
</footer>

<style>
  .footer { border-top: 4px solid var(--orange); background: #000000bd; font-family: var(--font-display); padding: 0 var(--gutter); }
  .footer__inner { max-width: var(--max); margin: 0 auto; padding: 48px 0 24px; display: grid; grid-template-columns: 1.2fr 1fr 1.6fr 1fr; gap: 32px; }
  .footer__brand img { width: 104px; height: auto; }
  .footer__brand p { font-size: 12px; margin: 8px 0 0; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 10px; line-height: 1.3; }
  ul a { font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; text-decoration: underline; color: var(--cream); }
  ul a:hover { color: var(--orange); }
  .footer__copy { text-align: center; font-size: 12px; padding: 32px 0 40px; margin: 0; }
  @media (max-width: 767px) { .footer__inner { grid-template-columns: 1fr 1fr; } }
</style>
