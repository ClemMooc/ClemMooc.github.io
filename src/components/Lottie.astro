---
// Plays a Lottie animation from /public/lottie/<name>.json
// Looping animations play for up to 5 seconds, then rest (accessibility requirement).
interface Props { name: string; class?: string; loop?: boolean; label?: string }
const { name, class: className, loop = true, label } = Astro.props;
---
<div class:list={['lottie', className]} data-lottie={`/lottie/${name}.json`} data-loop={String(loop)}
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}></div>

<script>
  import lottie from 'lottie-web/build/player/lottie_light';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-lottie]').forEach((el) => {
    if (el.dataset.ready) return;
    el.dataset.ready = '1';
    const anim = lottie.loadAnimation({
      container: el,
      renderer: 'svg',
      loop: el.dataset.loop === 'true',
      autoplay: !reduce,
      path: el.dataset.lottie!,
      rendererSettings: { preserveAspectRatio: 'xMidYMid slice' },
    });
    // Accessibility (WCAG 2.2.2): looping motion stops within 5 seconds.
    // Short loops finish their current cycle first, so they come to rest cleanly.
    if (el.dataset.loop === 'true' && !reduce) {
      anim.addEventListener('DOMLoaded', () => {
        const loopMs = anim.getDuration() * 1000;
        const start = performance.now();
        if (loopMs >= 5000) setTimeout(() => anim.pause(), 5000);
        else anim.addEventListener('loopComplete', () => {
          if (performance.now() - start + loopMs > 5000) anim.goToAndStop(0, true);
        });
      });
    }
  });
</script>
