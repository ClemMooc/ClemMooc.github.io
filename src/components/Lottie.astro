---
// Plays a Lottie animation from /public/lottie/<name>.json
// Looping animations play for 2 seconds, then glide smoothly to a stop by 5 seconds (accessibility requirement).
interface Props { name: string; class?: string; loop?: boolean; label?: string }
const { name, class: className, loop = true, label } = Astro.props;
---
<div class:list={['lottie', className]} data-lottie={`/lottie/${name}.json`} data-loop={String(loop)}
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}></div>

<script>
  import lottie from 'lottie-web/build/player/lottie_light';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-lottie]').forEach((el) => {
    if (el.dataset.ready) return;
    el.dataset.ready = '1';
    const anim = lottie.loadAnimation({
      container: el,
      renderer: 'svg',
      loop: el.dataset.loop === 'true',
      autoplay: !reduce,
      path: el.dataset.lottie!,
      rendererSettings: { preserveAspectRatio: 'xMidYMid slice' },
    });
    // Accessibility (WCAG 2.2.2): looping motion stops within 5 seconds.
    // Plays normally for 2 seconds, then glides to a stop over the next 3 (still at rest by 5 s).
    // Speed follows a cosine curve: it starts slowing imperceptibly and settles softly, with no jolt at either end.
    const EASE_START = 2000, EASE_LENGTH = 3000;
    if (el.dataset.loop === 'true' && !reduce) {
      anim.setSubframe(true); // smooth in-between frames at very low speeds
      anim.addEventListener('DOMLoaded', () => {
        setTimeout(() => {
          const t0 = performance.now();
          const slow = (now: number) => {
            const p = Math.min((now - t0) / EASE_LENGTH, 1);
            const speed = (1 + Math.cos(Math.PI * p)) / 2;
            if (p >= 1) { anim.pause(); return; }
            anim.setSpeed(speed);
            requestAnimationFrame(slow);
          };
          requestAnimationFrame(slow);
        }, EASE_START);
      });
    }
  });
</script>
