---
// Home page project grid with category tabs.
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import ProjectCard from './ProjectCard.astro';

interface Props { id?: string }
const { id = 'projects' } = Astro.props;
const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const cats = site.categories.filter((c) => work.some((w) => w.data.category === c.key));
---
<div class="tabs" data-project-tabs={id}>
  <div class="tabs__menu" role="tablist" aria-label="Project categories">
    {cats.map((c, i) => (
      <button type="button" class="tabs__tab" id={`${id}-tab-${c.key}`} aria-selected={i === 0 ? 'true' : 'false'}>{c.label}</button>
    ))}
  </div>
  {cats.map((c, i) => (
    <div class="tabs__pane" id={`${id}-panel-${c.key}`} hidden={i !== 0}>
      {work.filter((w) => w.data.category === c.key).map((w) => (
        <ProjectCard href={`/work/${w.id}/`} cover={w.data.cover} title={w.data.cardTitle} />
      ))}
    </div>
  ))}
</div>

<script>
  import { initTabs } from '../lib/tabs';
  document.querySelectorAll<HTMLElement>('[data-project-tabs]').forEach((root) => {
    initTabs(
      [...root.querySelectorAll<HTMLElement>('.tabs__tab')],
      [...root.querySelectorAll<HTMLElement>('.tabs__pane')],
      root.dataset.projectTabs!,
    );
  });
</script>

<style>
  .tabs__menu { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin: 0 0 40px; }
  .tabs__tab {
    cursor: pointer; border: 4px solid #000; border-radius: 30px; padding: 12px 20px;
    background: #ddd; color: #000;
    font-family: var(--font-display); font-size: 14px; font-weight: 500; letter-spacing: 2px; text-transform: uppercase;
    white-space: nowrap;
    transition: background-color .2s, color .2s;
  }
  .tabs__tab:hover { background: #ce1d10; color: #fff; }
  .tabs__tab[aria-selected='true'] { background: var(--rust); color: #fff; border-color: var(--blue); outline: 4px solid #000; }
  .tabs__tab:focus-visible { outline: 3px solid var(--teal); outline-offset: 3px; }
  .tabs__pane { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .tabs__pane[hidden] { display: none; }
  .tabs__pane:focus-visible { outline: 3px solid var(--teal); outline-offset: 8px; border-radius: 20px; }

  @media (max-width: 767px) {
    /* One swipeable row of tabs instead of three stacked rows */
    .tabs__menu {
      flex-wrap: nowrap; justify-content: flex-start; gap: 10px; overflow-x: auto;
      margin: 0 calc(var(--gutter) * -1) 28px; padding: 8px var(--gutter);
      scroll-snap-type: x proximity; scrollbar-width: none;
    }
    .tabs__menu::-webkit-scrollbar { display: none; }
    .tabs__tab { scroll-snap-align: start; padding: 10px 16px; font-size: 13px; letter-spacing: 1.5px; border-width: 3px; }
    .tabs__pane { grid-template-columns: 1fr; }
  }
</style>
