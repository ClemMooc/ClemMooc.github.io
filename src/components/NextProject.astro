---
// Bottom of each case study: one "Next project" card (the next featured project by `order`,
// wrapping around to the first) plus a link back to all work.
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props { current: string }
const { current } = Astro.props;
const all = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const me = all.find((w) => w.id === current);
const featured = all.filter((w) => w.data.featured && w.id !== current);
const next = featured.find((w) => me && w.data.order > me.data.order) ?? featured[0];
---
{next && (
  <section class="next section--dark" aria-labelledby="next-title">
    <div class="next__inner">
      <p class="eyebrow">Keep reading</p>
      <h2 id="next-title">Next project</h2>
      <div class="next__card">
        <ProjectCard href={`/work/${next.id}/`} cover={next.data.cover} title={next.data.cardTitle} role={next.data.role} />
      </div>
      <a class="next__all" href="/#projects">← Back to all projects</a>
    </div>
  </section>
)}

<style>
  .next { background: var(--ink); border-top: 1px solid var(--line-dark); }
  .next__inner { max-width: var(--max); margin: 0 auto; padding: 72px var(--gutter) 88px; text-align: center; }
  .next__card { max-width: 560px; margin: 0 auto 28px; text-align: left; }
  .next__all { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 600; color: var(--on-ink); text-decoration: none; }
  .next__all:hover { color: var(--accent); }
  @media (max-width: 767px) { .next__inner { padding-block: 48px 64px; } }
</style>
