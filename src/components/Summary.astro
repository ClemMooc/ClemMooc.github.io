---
// Quick-read summary at the top of a case study, for reviewers who skim.
// <Summary problem="..." role="..." methods="..." team="..." timeline="..." shipped="..." impact="..." />
// Any item left out is simply not shown.
interface Props {
  problem?: string; role?: string; methods?: string; team?: string;
  timeline?: string; shipped?: string; impact?: string;
}
const p = Astro.props;
const rows = [
  ['The problem', p.problem], ['My role', p.role], ['Methods', p.methods],
  ['Team', p.team], ['Timeline', p.timeline], ['What we made', p.shipped],
].filter(([, v]) => v) as [string, string][];
---
<aside class="summary" aria-label="Project summary">
  <dl class="summary__grid">
    {rows.map(([k, v]) => (
      <div class:list={['summary__item', { 'summary__item--wide': k === 'The problem' || k === 'What we made' }]}>
        <dt>{k}</dt><dd>{v}</dd>
      </div>
    ))}
  </dl>
  {p.impact && <p class="summary__impact"><span class="summary__label">Impact</span>{p.impact}</p>}
</aside>

<style>
  .summary { margin: 2rem 0 1rem; padding: 28px; border-radius: var(--radius); background: #fff; color: var(--ink); border: 1px solid #0000001a; }
  :global(.section--dark) .summary { background: var(--surface); color: var(--cream); border-color: var(--line); }
  .summary__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px 28px; margin: 0; }
  .summary__item--wide { grid-column: span 2; }
  dt, .summary__label {
    display: block; font-family: var(--font-display); font-size: 13px; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: .4em;
  }
  :global(.section--dark) dt, :global(.section--dark) .summary__label { color: var(--muted); }
  dd { margin: 0; font-size: 16px; line-height: 1.6; }
  .summary__impact {
    margin: 24px 0 0; padding: 18px 20px; border-left: 3px solid var(--orange-ink); background: var(--paper);
    font-size: 17px; line-height: 1.6;
  }
  :global(.section--dark) .summary__impact { border-left-color: var(--orange); background: #ffffff0a; }
  @media (max-width: 900px) {
    .summary__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .summary { padding: 20px; }
    .summary__grid { grid-template-columns: 1fr; }
    .summary__item--wide { grid-column: auto; }
  }
</style>
